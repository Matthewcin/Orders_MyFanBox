# Copia este archivo como .env para desarrollo local.
# Pega aquí la URL PostgreSQL de Neon. Nunca la pongas en el frontend.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST_NEON/BASE?sslmode=require

# Credenciales iniciales del panel. Cambia la contraseña antes de publicar.
MFB_ADMIN_USERNAME=admin
MFB_ADMIN_PASSWORD=CAMBIA-ESTA-CLAVE-POR-UNA-LARGA-Y-UNICA

# Secreto aleatorio de al menos 32 caracteres para firmar sesiones.
MFB_SESSION_SECRET=REEMPLAZA-POR-UN-SECRETO-ALEATORIO-DE-AL-MENOS-32-CARACTERES

PORT=3001

# Origin(s) exact(s) del frontend, separados por coma. Ej.: https://TU-USUARIO.github.io
MFB_ALLOWED_ORIGINS=http://localhost:5173

VITE_API_BASE_URL=https://orders-myfanbox.onrender.com
